# Copy this file to .env and fill in real values. Never commit .env.
# Supabase dashboard -> Project Settings -> Data API  (Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# SERVER-SIDE ONLY. This key bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_X-xvOw4PaFMU0-hcPK0_LQ_Uoxxxxx

# ---- Medisina API (contract reference: portal-backend/) ----
# Base URL of the Medisina API. The contract has no servers list, so it comes from here.
MEDISINA_API_BASE_URL=https://medisina-api.example.com
# Account this backend logs in with (POST /auth/login). SERVER-SIDE ONLY.
MEDISINA_EMAIL=service-account@example.com
MEDISINA_PASSWORD=replace_me
# PATIENT or DOCTOR
MEDISINA_USER_TYPE=PATIENT
# MEDISINA_TIMEOUT_SECONDS=15
