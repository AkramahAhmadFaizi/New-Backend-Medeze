# Copy to .env.flyway and fill in. NEVER commit .env.flyway.
# Supabase dashboard -> Connect -> Session pooler (port 5432).
# Use the SESSION pooler: the direct connection is IPv6-only and the
# transaction pooler (port 6543) is not safe for migrations.
FLYWAY_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
FLYWAY_USER=postgres.your-project-ref
# DATABASE password (Project Settings -> Database), NOT the API secret key.
FLYWAY_PASSWORD=replace_me