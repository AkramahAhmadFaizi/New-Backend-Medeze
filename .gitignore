$gitignore = @'
# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Tests, type checkers, linters ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Logs ----
*.log

# ---- Editors / OS ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Supabase CLI local state (for future migrations) ----
supabase/.branches/
supabase/.temp/
'@
[IO.File]::WriteAllText((Join-Path $PWD.Path ".gitignore"), $gitignore)

setup.ps1
therapy-api.postman_collection.json