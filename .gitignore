# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
# Postman environments/globals can hold tokens and passwords.
# (The collection itself, therapy-api.postman_collection.json, IS committed.)
*.postman_environment.json
*.postman_globals.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Tests, type checkers, linters ----
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Logs ----
*.log

# ---- Editors / OS ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
._*
Thumbs.db
desktop.ini

# ---- Supabase CLI local state (for future migrations) ----
supabase/.branches/
supabase/.temp/

# ---- Claude Code (personal settings; claude.md IS committed) ----
.claude/settings.local.json

# ---- Medisina contract ----
# portal-backend/swagger.json IS committed on purpose: after
# `python portal-backend/contract.py pull`, `git diff` shows what Medisina changed.
