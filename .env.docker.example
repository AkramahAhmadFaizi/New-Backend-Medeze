# Written automatically by .\dev.ps1 setup (you normally never edit this).
# Inside Docker it OVERRIDES .env, pointing the API at LOCAL Supabase.
# Medisina settings still come from .env. Never put cloud keys here.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SECRET_KEY=<from: npx supabase status>
APP_ENV=local
OTP_PROVIDER=fake
OTP_TOKEN_SECRET=<generated>
